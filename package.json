{
  "name": "pi-open-tui-fixed",
  "version": "0.5.1",
  "description": "Fork of pi-open-tui for the Pi coding agent: same TUI, but working-state refresh defaults to event-driven so terminal scrollback stays stable while the model works.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doccker/pi-open-tui-fixed.git"
  },
  "homepage": "https://github.com/doccker/pi-open-tui-fixed#readme",
  "bugs": {
    "url": "https://github.com/doccker/pi-open-tui-fixed/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "tui",
    "starship",
    "theme"
  ],
  "license": "MIT",
  "files": [
    "extensions/",
    "docs/",
    "assets/",
    "CHANGELOG.md",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/settings-command.test.ts tests/footer.test.ts tests/footer-protocol.test.ts tests/footer-segments.test.ts tests/delegate-tps.test.ts tests/editor.test.ts tests/telemetry.test.ts tests/peek.test.ts tests/tool-view.test.ts tests/copy-buttons.test.ts tests/copy-markdown.test.ts tests/working-refresh.test.ts tests/terminal-title.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "pi": {
    "extensions": [
      "./extensions/open-tui/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/doccker/pi-open-tui-fixed/main/assets/preview_dashboard_1.png"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=1.5.0",
    "@earendil-works/pi-coding-agent": ">=1.5.0",
    "@earendil-works/pi-tui": ">=1.5.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.5.0",
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@earendil-works/pi-tui": "^1.5.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "diff": "^9.0.0"
  }
}
